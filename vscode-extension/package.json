{
  "name": "mightora-architecture-modeller",
  "displayName": "Mightora Architecture Modeller",
  "description": "Model architecture, dependencies, business processes, stakeholders and layers in desktop VS Code and VS Code for the Web.",
  "publisher": "mightoraio",
  "version": "0.6.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "architecture",
    "modelling",
    "dependencies",
    "RACI",
    "Power Platform"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mightora/architecture-modeller.mightora.io.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://architecture-modeller.mightora.io/",
  "bugs": {
    "url": "https://github.com/mightora/architecture-modeller.mightora.io/issues"
  },
  "icon": "media/icon.png",
  "browser": "./extension.js",
  "main": "./extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onCustomEditor:mightora.architectureModeller"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mightora.architecture.new",
        "title": "Architecture Modeller: Create New Model"
      },
      {
        "command": "mightora.architecture.open",
        "title": "Architecture Modeller: Open Visual Editor"
      },
      {
        "command": "mightora.architecture.validate",
        "title": "Architecture Modeller: Validate Architecture"
      },
      {
        "command": "mightora.architecture.viewpoint",
        "title": "Architecture Modeller: Select Viewpoint"
      },
      {
        "command": "mightora.architecture.word",
        "title": "Architecture Modeller: Export to Word"
      },
      {
        "command": "mightora.architecture.powerpoint",
        "title": "Architecture Modeller: Export to PowerPoint"
      },
      {
        "command": "mightora.architecture.documentation",
        "title": "Architecture Modeller: Generate Documentation"
      },
      {
        "command": "mightora.architecture.compare",
        "title": "Architecture Modeller: Compare Models"
      },
      {
        "command": "mightora.architecture.adr",
        "title": "Architecture Modeller: Create Architecture Decision Record"
      },
      {
        "command": "mightora.architecture.search",
        "title": "Architecture Modeller: Search Components"
      },
      {
        "command": "mightora.architecture.reveal",
        "title": "Architecture Modeller: Reveal Component"
      }
    ],
    "customEditors": [
      {
        "viewType": "mightora.architectureModeller",
        "displayName": "Mightora Architecture Modeller",
        "selector": [
          {
            "filenamePattern": "*.architecture.json"
          },
          {
            "filenamePattern": "*.architecture.yaml"
          },
          {
            "filenamePattern": "*.architecture.yml"
          },
          {
            "filenamePattern": "*.archmodel.json"
          },
          {
            "filenamePattern": "*.archmodel.yaml"
          },
          {
            "filenamePattern": "*.archmodel.yml"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mightoraArchitectureOutline",
          "name": "Architecture Outline",
          "when": "activeCustomEditorId == mightora.architectureModeller"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "mightora.architecture.open",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "mightora.architecture.word",
          "when": "activeCustomEditorId == mightora.architectureModeller",
          "group": "navigation@1"
        },
        {
          "command": "mightora.architecture.powerpoint",
          "when": "activeCustomEditorId == mightora.architectureModeller",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm --prefix .. run build:offline",
    "package": "vsce package --no-dependencies"
  }
}
